APP_ORIGIN=http://localhost:3000
RP_NAME=Caelia
# Optional; defaults to the hostname in APP_ORIGIN.
# For https://caeliasystems.com, use caeliasystems.com.
RP_ID=localhost
PORT=3000
DATABASE_PATH=./data/caelia.sqlite
# Generate a one-time bootstrap code out of band (at least 32 random characters).
# Leave unset to disable new account enrollment.
INITIAL_ENROLLMENT_CODE=

# Optional trusted service adapters. Leave unset until each service is available.
# Each configured service requires a matching environment value (at least 24 characters).
CAELIA_BACKEND_URL=
CAELIA_BACKEND_TOKEN=
CAELIA_BRAIN_URL=
CAELIA_BRAIN_TOKEN=
UNITY_BRIDGE_URL=
UNITY_BRIDGE_TOKEN=
