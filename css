// Natural head/eye attention toward the pointer. stage.addEventListener("pointermove", e => { const r = stage.getBoundingClientRect(); const nx = (e.clientX - r.left) / r.width - .5; const ny = (e.clientY - r.top) / r.height - .5; const dx = nx * 4, dy = ny * 2; eyeL.setAttribute("cx", 283 + dx); eyeL.setAttribute("cy", 276 + dy); eyeR.setAttribute("cx", 317 + dx); eyeR.setAttribute("cy", 276 + dy); });
