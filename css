function wave() { const arm = document.getElementById("armR"); arm.animate([ {transform:"rotate(0deg)", transformOrigin:"410px 530px"}, {transform:"rotate(-12deg)", transformOrigin:"410px 530px"}, {transform:"rotate(8deg)", transformOrigin:"410px 530px"}, {transform:"rotate(-8deg)", transformOrigin:"410px 530px"}, {transform:"rotate(0deg)", transformOrigin:"410px 530px"} ], {duration:1200, easing:"ease-in-out"}); burst(18, 80); }
// WOW #2: Soul Bloom — the heart light expands into a soft constellation. function soulBloom() { burst(110, 330); stage.classList.add("is-pulsing"); setTimeout(() => stage.classList.remove("is-pulsing"), 2500); }
// WOW #3: Graceful bow — subtle, human, elegant rather than robotic. function bow() { motion.animate([ {transform:"translateY(0) rotate(0deg)"}, {transform:"translateY(5px) rotate(1.5deg)"}, {transform:"translateY(20px) rotate(0deg)"}, {transform:"translateY(0) rotate(0deg)"} ], {duration:1600, easing:"cubic-bezier(.22,.8,.25,1)"}); }
