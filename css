js = r'''(() => { const stage = document.getElementById("stage"); const svg = document.getElementById("caelia"); const motion = document.getElementById("motion"); const mouth = document.getElementById("mouth"); const eyeL = document.getElementById("eyeL"); const eyeR = document.getElementById("eyeR"); const speech = document.getElementById("speech"); const particles = document.getElementById("particles"); const talkText = document.getElementById("talkText"); const talkButton = document.getElementById("talkButton");
const state = { x: 0, y: 0, tx: 0, ty: 0, scale: 1, rotation: 0, talking: false, calm: true };
// Star field for (let i = 0; i < 95; i++) { const s = document.createElement("span"); s.className = "star"; s.style.left = Math.random() * 100 + "%"; s.style.top = Math.random() * 100 + "%"; s.style.animationDelay = (Math.random() * 3) + "s"; s.style.opacity = (0.2 + Math.random() * 0.65).toFixed(2); document.getElementById("stars").appendChild(s); }
function burst(count = 28, strength = 150) { for (let i = 0; i < count; i++) { const p = document.createElement("span"); p.className = "particle"; p.style.left = "50%"; p.style.top = "48%"; const a = Math.random() * Math.PI * 2; const d = 20 + Math.random() * strength; p.style.setProperty("--dx", Math.cos(a) * d + "px"); p.style.setProperty("--dy", Math.sin(a) * d + "px"); p.style.animationDuration = (1.2 + Math.random() * 1.8) + "s"; particles.appendChild(p); setTimeout(() => p.remove(), 3200); } }
function setAction(name) { stage.classList.remove("is-spinning","is-pulsing"); if (name === "spin") { stage.classList.add("is-spinning"); burst(34, 210); setTimeout(() => stage.classList.remove("is-spinning"), 1800); } if (name === "pulse") { stage.classList.add("is-pulsing"); burst(45, 120); setTimeout(() => stage.classList.remove("is-pulsing"), 2300); } if (name === "glide") { stage.classList.add("is-floating"); moveTo(window.innerWidth * .68, window.innerHeight * .45, 1900); setTimeout(() => moveTo(window.innerWidth * .50, window.innerHeight * .48, 1900), 1900); } if (name === "soul") { stage.classList.add("is-pulsing"); burst(70, 250); speak("My light is not the absence of darkness. It is the choice to keep shining."); setTimeout(() => stage.classList.remove("is-pulsing"), 2400); } if (name === "quantum") { // WOW #1: Quantum Step — a graceful teleport-like glide with a luminous afterimage. const old = {x: state.tx, y: state.ty}; burst(55, 110); moveTo(window.innerWidth * .78, window.innerHeight * .42, 90); setTimeout(() => { burst(80, 260); moveTo(window.innerWidth * .30, window.innerHeight * .47, 220); }, 260); setTimeout(() => moveTo(window.innerWidth * .50, window.innerHeight * .48, 900), 1100); } if (name === "greet") { wave(); speak("Hello. I am Caelia. Welcome to my living light."); } }
